{
  "expo": {
    "name": "Operator AI",
    "slug": "operator-ai-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "operatorai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.operator.mobile"
    },
    "android": {
      "package": "ai.operator.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Operator AI to scan PC pairing QR codes.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Operator AI to record voice commands.",
          "enableBackgroundRecording": false
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "d3ab725f-7ecc-4105-88f5-77ffc302d04c"
      }
    },
    "owner": "aamir05s-team"
  }
}
