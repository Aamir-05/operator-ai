<Window x:Class="Operator.Desktop.MultiWindowDestinationTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operator AI Destination Application"
        Width="680"
        Height="500"
        MinWidth="600"
        MinHeight="430"
        WindowStartupLocation="Manual">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- HEADER                                            -->
        <!-- ================================================= -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,26">

            <TextBlock
                Text="Operator AI Destination Application"
                FontSize="27"
                FontWeight="Bold"/>

            <TextBlock
                Text="Version 0.7C - deterministic destination window"
                FontSize="14"
                Margin="0,5,0,0"/>

        </StackPanel>

        <!-- ================================================= -->
        <!-- DESTINATION VALUE                                 -->
        <!-- ================================================= -->

        <StackPanel Grid.Row="1"
                    Margin="0,0,0,22">

            <TextBlock
                Text="Destination Value"
                FontWeight="SemiBold"
                Margin="0,0,0,7"/>

            <TextBox
                x:Name="DestinationValueBox"
                AutomationProperties.Name="Destination Value"
                AutomationProperties.AutomationId="DestinationValueBox"
                Width="500"
                Height="42"
                HorizontalAlignment="Left"
                Padding="9"
                FontSize="15"/>

        </StackPanel>

        <!-- ================================================= -->
        <!-- VERIFY TRANSFER CHECKBOX                          -->
        <!-- ================================================= -->

        <CheckBox
            Grid.Row="2"
            x:Name="VerifyTransferCheckBox"
            AutomationProperties.Name="Verify transfer"
            AutomationProperties.AutomationId="VerifyTransferCheckBox"
            Content="Verify transfer"
            FontSize="15"
            Margin="0,0,0,22"/>

        <!-- ================================================= -->
        <!-- APPLY                                             -->
        <!-- ================================================= -->

        <Button
            Grid.Row="3"
            x:Name="ApplyTransferButton"
            AutomationProperties.Name="Apply Transfer"
            AutomationProperties.AutomationId="ApplyTransferButton"
            Content="Apply Transfer"
            Width="170"
            Height="44"
            HorizontalAlignment="Left"
            Margin="0,0,0,22"
            Click="ApplyTransfer_Click"/>

        <!-- ================================================= -->
        <!-- STATUS                                            -->
        <!-- ================================================= -->

        <TextBox
            Grid.Row="4"
            x:Name="DestinationStatusBox"
            AutomationProperties.Name="Destination Status"
            AutomationProperties.AutomationId="DestinationStatusBox"
            IsReadOnly="True"
            TextWrapping="Wrap"
            AcceptsReturn="True"
            VerticalScrollBarVisibility="Auto"
            FontFamily="Consolas"
            FontSize="14"
            Padding="12"
            Text="Destination status: waiting"/>

    </Grid>

</Window>