<Window x:Class="Operator.Desktop.ReviewDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operator AI Review Dialog"
        Width="620"
        Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- HEADER                                            -->
        <!-- ================================================= -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,24">

            <TextBlock
                Text="Review Dialog"
                FontSize="26"
                FontWeight="Bold"/>

            <TextBlock
                Text="Controlled modal dialog for Operator AI 0.7B"
                Margin="0,5,0,0"/>

        </StackPanel>

        <!-- ================================================= -->
        <!-- REFERENCE CODE                                    -->
        <!-- ================================================= -->

        <StackPanel Grid.Row="1"
                    Margin="0,0,0,20">

            <TextBlock
                Text="Reference Code"
                FontWeight="SemiBold"
                Margin="0,0,0,6"/>

            <TextBox
                x:Name="ReferenceCodeBox"
                AutomationProperties.Name="Reference Code"
                AutomationProperties.AutomationId="ReferenceCodeInput"
                Width="360"
                Height="38"
                HorizontalAlignment="Left"
                Padding="8"
                FontSize="15"/>

        </StackPanel>

        <!-- ================================================= -->
        <!-- CONFIRM                                           -->
        <!-- ================================================= -->

        <CheckBox
            Grid.Row="2"
            x:Name="ConfirmReviewCheckBox"
            AutomationProperties.Name="Confirm review"
            AutomationProperties.AutomationId="ConfirmReviewCheckBox"
            Content="Confirm review"
            FontSize="15"
            Margin="0,0,0,20"/>

        <!-- ================================================= -->
        <!-- VALIDATION STATUS                                 -->
        <!-- ================================================= -->

        <TextBox
            Grid.Row="3"
            x:Name="DialogStatusBox"
            AutomationProperties.Name="Dialog Status"
            AutomationProperties.AutomationId="DialogStatusBox"
            IsReadOnly="True"
            Height="55"
            Padding="10"
            FontFamily="Consolas"
            Text="Validation: waiting"/>

        <!-- ================================================= -->
        <!-- SPACER                                            -->
        <!-- ================================================= -->

        <Grid Grid.Row="4"/>

        <!-- ================================================= -->
        <!-- BUTTONS                                           -->
        <!-- ================================================= -->

        <StackPanel
            Grid.Row="5"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,22,0,0">

            <Button
                x:Name="CancelButton"
                AutomationProperties.Name="Cancel"
                AutomationProperties.AutomationId="CancelButton"
                Content="Cancel"
                Width="120"
                Height="42"
                Margin="0,0,10,0"
                IsCancel="True"
                Click="Cancel_Click"/>

            <Button
                x:Name="ApplyReviewButton"
                AutomationProperties.Name="Apply Review"
                AutomationProperties.AutomationId="ApplyReviewButton"
                Content="Apply Review"
                Width="140"
                Height="42"
                IsDefault="True"
                Click="ApplyReview_Click"/>

        </StackPanel>

    </Grid>

</Window>