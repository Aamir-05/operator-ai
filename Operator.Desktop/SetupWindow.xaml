<Window x:Class="Operator.Desktop.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operator AI Setup"
        Width="620"
        Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F5F7">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Operator AI 1.0 Setup" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="Configure the local agent and optional mobile remote control."
                       Foreground="#64748B" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="12"
                BorderBrush="#E5E7EB" BorderThickness="1" Padding="20">
            <StackPanel>
                <TextBlock Text="OpenAI API key" FontWeight="SemiBold"/>
                <PasswordBox x:Name="ApiKeyBox" Margin="0,7,0,5" Height="36" Padding="8"/>
                <TextBlock Text="Stored in Windows Credential Manager, not in the settings JSON."
                           FontSize="12" Foreground="#64748B" Margin="0,0,0,18"/>

                <TextBlock Text="Operator Cloud project URL" FontWeight="SemiBold"/>
                <TextBox x:Name="ProjectUrlBox" Margin="0,7,0,5" Height="36" Padding="8"/>
                <TextBlock Text="Example: https://your-project-ref.supabase.co"
                           FontSize="12" Foreground="#64748B" Margin="0,0,0,18"/>

                <TextBlock Text="Computer name" FontWeight="SemiBold"/>
                <TextBox x:Name="DeviceNameBox" Margin="0,7,0,16" Height="36" Padding="8"/>

                <CheckBox x:Name="RemoteEnabledCheckBox"
                          Content="Enable Operator AI Mobile remote commands"
                          Margin="0,0,0,10"/>

                <CheckBox x:Name="StartWithWindowsCheckBox"
                          Content="Start Operator AI with Windows"
                          Margin="0,0,0,10"/>

                <CheckBox x:Name="ScreenshotCheckBox"
                          Content="Attach a completion screenshot to remote tasks"
                          Margin="0,0,0,10"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Width="100" Height="38" Margin="0,0,10,0" IsCancel="True"/>
            <Button Content="Save" Width="110" Height="38" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
