<Window x:Class="Operator.Desktop.DialogWorkflowTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operator AI Dialog Workflow Test"
        Width="820"
        Height="560"
        MinWidth="700"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- MENU                                              -->
        <!-- ================================================= -->

        <Menu Grid.Row="0"
              AutomationProperties.Name="Workflow Menu"
              AutomationProperties.AutomationId="WorkflowMenu">

            <MenuItem
                Header="_Open Review Dialog"
                AutomationProperties.Name="Open Review Dialog"
                AutomationProperties.AutomationId="OpenReviewDialogMenuItem"
                Click="OpenReviewDialogMenuItem_Click"/>

        </Menu>

        <!-- ================================================= -->
        <!-- CONTENT                                           -->
        <!-- ================================================= -->

        <Grid Grid.Row="1"
              Margin="32">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,24">

                <TextBlock
                    Text="Operator AI Dialog Workflow Test"
                    FontSize="28"
                    FontWeight="Bold"/>

                <TextBlock
                    Text="Version 0.7B - Menu and modal dialog automation"
                    FontSize="15"
                    Margin="0,5,0,0"/>

            </StackPanel>

            <Border Grid.Row="1"
                    BorderBrush="#B8B8B8"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="18"
                    Margin="0,0,0,22">

                <StackPanel>

                    <TextBlock
                        Text="Workflow"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Margin="0,0,0,8"/>

                    <TextBlock
                        TextWrapping="Wrap"
                        Text="Use the Open Review Dialog menu command. The review window is modal and returns a deterministic result to this parent window."/>

                </StackPanel>

            </Border>

            <TextBlock
                Grid.Row="2"
                Text="Workflow Status"
                FontWeight="SemiBold"
                Margin="0,0,0,7"/>

            <TextBox
                Grid.Row="3"
                x:Name="WorkflowStatusBox"
                AutomationProperties.Name="Workflow Status"
                AutomationProperties.AutomationId="WorkflowStatusBox"
                IsReadOnly="True"
                TextWrapping="Wrap"
                AcceptsReturn="True"
                VerticalScrollBarVisibility="Auto"
                FontFamily="Consolas"
                FontSize="15"
                Padding="14"
                Text="Result: waiting for dialog workflow"/>

        </Grid>

    </Grid>

</Window>