<Window x:Class="Operator.Desktop.MultiWindowSourceTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operator AI Source Application"
        Width="680"
        Height="430"
        MinWidth="600"
        MinHeight="380"
        WindowStartupLocation="Manual">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- HEADER                                            -->
        <!-- ================================================= -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,26">

            <TextBlock
                Text="Operator AI Source Application"
                FontSize="27"
                FontWeight="Bold"/>

            <TextBlock
                Text="Version 0.7C - deterministic source window"
                FontSize="14"
                Margin="0,5,0,0"/>

        </StackPanel>

        <!-- ================================================= -->
        <!-- SOURCE VALUE                                      -->
        <!-- ================================================= -->

        <StackPanel Grid.Row="1"
                    Margin="0,0,0,22">

            <TextBlock
                Text="Source Value"
                FontWeight="SemiBold"
                Margin="0,0,0,7"/>

            <TextBox
                x:Name="SourceValueBox"
                AutomationProperties.Name="Source Value"
                AutomationProperties.AutomationId="SourceValueBox"
                Width="500"
                Height="42"
                HorizontalAlignment="Left"
                Padding="9"
                FontSize="15"
                IsReadOnly="True"
                Text="OPS-TRANSFER-07C-001"/>

        </StackPanel>

        <!-- ================================================= -->
        <!-- SOURCE DESCRIPTION                                -->
        <!-- ================================================= -->

        <StackPanel Grid.Row="2"
                    Margin="0,0,0,22">

            <TextBlock
                Text="Source Description"
                FontWeight="SemiBold"
                Margin="0,0,0,7"/>

            <TextBox
                x:Name="SourceDescriptionBox"
                AutomationProperties.Name="Source Description"
                AutomationProperties.AutomationId="SourceDescriptionBox"
                Width="500"
                Height="80"
                HorizontalAlignment="Left"
                Padding="9"
                TextWrapping="Wrap"
                AcceptsReturn="True"
                IsReadOnly="True"
                Text="Transfer this reference into the destination application and verify the destination accepted it."/>

        </StackPanel>

        <!-- ================================================= -->
        <!-- STATUS                                            -->
        <!-- ================================================= -->

        <TextBox
            Grid.Row="3"
            x:Name="SourceStatusBox"
            AutomationProperties.Name="Source Status"
            AutomationProperties.AutomationId="SourceStatusBox"
            IsReadOnly="True"
            TextWrapping="Wrap"
            AcceptsReturn="True"
            FontFamily="Consolas"
            FontSize="14"
            Padding="12"
            Text="Source status: ready"/>

    </Grid>

</Window>