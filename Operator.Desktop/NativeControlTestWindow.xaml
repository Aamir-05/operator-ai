<Window x:Class="Operator.Desktop.NativeControlTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operator AI Native Control Test"
        Width="850"
        Height="680"
        MinWidth="700"
        MinHeight="600"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="32">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- HEADER                                            -->
        <!-- ================================================= -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,24">

            <TextBlock
                Text="Operator AI Native Control Test"
                FontSize="28"
                FontWeight="Bold"/>

            <TextBlock
                Text="Version 0.7A - Windows UI Automation"
                FontSize="15"
                Margin="0,5,0,0"/>

        </StackPanel>

        <!-- ================================================= -->
        <!-- TEXTBOX                                           -->
        <!-- ================================================= -->

        <StackPanel Grid.Row="1"
                    Margin="0,0,0,20">

            <TextBlock
                Text="Operator Name"
                FontWeight="SemiBold"
                Margin="0,0,0,6"/>

            <TextBox
                x:Name="OperatorNameBox"
                AutomationProperties.Name="Operator Name"
                AutomationProperties.AutomationId="OperatorNameInput"
                Width="420"
                Height="38"
                HorizontalAlignment="Left"
                Padding="8"
                FontSize="15"
                Text="Initial value"/>

        </StackPanel>

        <!-- ================================================= -->
        <!-- CHECKBOX                                          -->
        <!-- ================================================= -->

        <StackPanel Grid.Row="2"
                    Margin="0,0,0,20">

            <CheckBox
                x:Name="EnableAutomationCheckBox"
                AutomationProperties.Name="Enable automation"
                AutomationProperties.AutomationId="EnableAutomationCheckBox"
                Content="Enable automation"
                FontSize="15"
                IsChecked="False"/>

        </StackPanel>

        <!-- ================================================= -->
        <!-- COMBO BOX                                         -->
        <!-- ================================================= -->

        <StackPanel Grid.Row="3"
                    Margin="0,0,0,20">

            <TextBlock
                Text="Department"
                FontWeight="SemiBold"
                Margin="0,0,0,6"/>

            <ComboBox
                x:Name="DepartmentComboBox"
                AutomationProperties.Name="Department"
                AutomationProperties.AutomationId="DepartmentComboBox"
                Width="300"
                Height="38"
                HorizontalAlignment="Left"
                SelectedIndex="0">

                <ComboBoxItem
                    AutomationProperties.Name="Finance"
                    Content="Finance"/>

                <ComboBoxItem
                    AutomationProperties.Name="Operations"
                    Content="Operations"/>

                <ComboBoxItem
                    AutomationProperties.Name="Maintenance"
                    Content="Maintenance"/>

                <ComboBoxItem
                    AutomationProperties.Name="Engineering"
                    Content="Engineering"/>

            </ComboBox>

        </StackPanel>

        <!-- ================================================= -->
        <!-- TABS                                              -->
        <!-- ================================================= -->

        <StackPanel Grid.Row="4"
                    Margin="0,0,0,20">

            <TextBlock
                Text="Workspace"
                FontWeight="SemiBold"
                Margin="0,0,0,6"/>

            <TabControl
                x:Name="WorkspaceTabs"
                AutomationProperties.Name="Workspace"
                AutomationProperties.AutomationId="WorkspaceTabs"
                Height="150">

                <TabItem
                    Header="Overview"
                    AutomationProperties.Name="Overview"
                    AutomationProperties.AutomationId="OverviewTab">

                    <Grid>

                        <TextBlock
                            Text="Overview workspace"
                            Margin="20"
                            FontSize="16"/>

                    </Grid>

                </TabItem>

                <TabItem
                    Header="Operations"
                    AutomationProperties.Name="Operations"
                    AutomationProperties.AutomationId="OperationsTab">

                    <Grid>

                        <TextBlock
                            Text="Operations workspace"
                            Margin="20"
                            FontSize="16"/>

                    </Grid>

                </TabItem>

            </TabControl>

        </StackPanel>

        <!-- ================================================= -->
        <!-- APPLY BUTTON                                      -->
        <!-- ================================================= -->

        <Button
            Grid.Row="5"
            x:Name="ApplyChangesButton"
            AutomationProperties.Name="Apply Changes"
            AutomationProperties.AutomationId="ApplyChangesButton"
            Content="Apply Changes"
            Width="180"
            Height="44"
            HorizontalAlignment="Left"
            Margin="0,0,0,20"
            Click="ApplyChanges_Click"/>

        <!-- ================================================= -->
        <!-- STATUS                                            -->
        <!-- ================================================= -->

        <StackPanel Grid.Row="6">

            <TextBlock
                Text="Test Status"
                FontWeight="SemiBold"
                Margin="0,0,0,6"/>

            <TextBox
                x:Name="StatusBox"
                AutomationProperties.Name="Test Status"
                AutomationProperties.AutomationId="TestStatusBox"
                IsReadOnly="True"
                TextWrapping="Wrap"
                AcceptsReturn="True"
                VerticalScrollBarVisibility="Auto"
                FontFamily="Consolas"
                FontSize="14"
                Padding="12"
                Text="Result: waiting for native control test"/>

        </StackPanel>

        <!-- ================================================= -->
        <!-- FOOTER                                            -->
        <!-- ================================================= -->

        <TextBlock
            Grid.Row="7"
            Margin="0,18,0,0"
            Text="This window is intentionally deterministic for Operator AI testing."
            Foreground="Gray"/>

    </Grid>

</Window>