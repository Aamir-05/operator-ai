<Window x:Class="Operator.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operator AI"
        Height="700"
        Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <TextBlock
                Text="Operator AI"
                FontSize="32"
                FontWeight="Bold"/>

            <TextBlock
                Text="Windows Agent - Version 0.5C"
                FontSize="14"
                Margin="0,5,0,20"/>

        </StackPanel>

        <TextBlock
            Grid.Row="1"
            Text="What should I do?"
            FontSize="18"
            FontWeight="SemiBold"
            Margin="0,0,0,8"/>

        <TextBox
            x:Name="TaskBox"
            Grid.Row="2"
            Height="90"
            FontSize="16"
            TextWrapping="Wrap"
            AcceptsReturn="True"
            VerticalScrollBarVisibility="Auto"
            Padding="12"
            Margin="0,0,0,12"/>

        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            Margin="0,0,0,20">

            <Button
                x:Name="AskAIButton"
                Content="Run AI Task"
                Width="160"
                Height="45"
                Margin="0,0,20,0"
                Click="AskAI_Click"/>

            <Button
                Content="Open Notepad"
                Width="140"
                Height="45"
                Margin="0,0,10,0"
                Click="OpenNotepad_Click"/>

            <Button
                Content="Create Test File"
                Width="150"
                Height="45"
                Margin="0,0,10,0"
                Click="CreateFile_Click"/>

            <Button
                Content="Verify File"
                Width="140"
                Height="45"
                Click="VerifyFile_Click"/>
            <Button
    Content="UI Type Test"
    Width="140"
    Height="45"
    Margin="10,0,0,0"
    Click="UiTypeTest_Click"/>
            <Button
    Content="Ctrl+S Test"
    Width="120"
    Height="45"
    Margin="10,0,0,0"
    Click="SaveKeyTest_Click"/>

        </StackPanel>

        <TextBlock
            Grid.Row="4"
            Text="Activity"
            FontSize="18"
            FontWeight="SemiBold"
            Margin="0,0,0,10"/>

        <TextBox
            x:Name="LogBox"
            Grid.Row="5"
            IsReadOnly="True"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto"
            FontFamily="Consolas"
            FontSize="14"
            Padding="15"/>

    </Grid>

</Window>