<Window x:Class="Operator.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operator AI 1.0"
        Height="1020"
        Width="1500"
        MinHeight="760"
        MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F7"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#111827"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>
        <Style x:Key="DiagnosticButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="14" Padding="20" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Operator AI" FontSize="30" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="Version 1.0 · Desktop Automation + Operator AI Mobile"
                               FontSize="14" Foreground="#64748B" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1"
                            CornerRadius="14" Padding="14,7" Margin="0,0,10,0">
                        <TextBlock Text="Production Safe Mode" Foreground="#047857" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                            CornerRadius="14" Padding="14,7">
                        <TextBlock x:Name="RemoteStatusText" Text="Remote loading..."
                                   Foreground="#1D4ED8" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="14" Padding="20" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Mobile Remote" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PairedDeviceText" Text="No mobile device paired"
                               Foreground="#64748B" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Setup" Style="{StaticResource SecondaryButton}" Click="SetupButton_Click"/>
                    <Button Content="Pair Mobile" Style="{StaticResource SecondaryButton}" Click="PairMobileButton_Click"/>
                    <Button x:Name="RemoteToggleButton" Content="Enable Remote"
                            Style="{StaticResource SecondaryButton}" Click="RemoteToggleButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="14" Padding="20" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="What should I do?" FontSize="18" FontWeight="SemiBold"
                           Foreground="#111827" Margin="0,0,0,10"/>
                <TextBox x:Name="TaskBox" Height="105" FontSize="15" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="12"
                         BorderBrush="#CBD5E1" Margin="0,0,0,14"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AskAIButton" Content="Run AI Task" Style="{StaticResource PrimaryButton}" Click="AskAI_Click"/>
                    <Button x:Name="StopTaskButton" Content="Stop Task" Style="{StaticResource SecondaryButton}"
                            IsEnabled="False" Click="StopTask_Click"/>
                    <TextBlock Text="Local tasks and paired mobile tasks use the same Operator Agent."
                               VerticalAlignment="Center" Foreground="#64748B" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Expander Grid.Row="3" Header="Regression &amp; Diagnostics" IsExpanded="False"
                  Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                  Padding="12" Margin="0,0,0,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="150">
                <WrapPanel Margin="0,10,0,0">
                    <Button Content="Open Notepad" Style="{StaticResource DiagnosticButton}" Click="OpenNotepad_Click"/>
                    <Button Content="Create Test File" Style="{StaticResource DiagnosticButton}" Click="CreateFile_Click"/>
                    <Button Content="Verify File" Style="{StaticResource DiagnosticButton}" Click="VerifyFile_Click"/>
                    <Button Content="UI Type Test" Style="{StaticResource DiagnosticButton}" Click="UiTypeTest_Click"/>
                    <Button Content="Ctrl+S Test" Style="{StaticResource DiagnosticButton}" Click="SaveKeyTest_Click"/>
                    <Button Content="Save Dialog Test" Style="{StaticResource DiagnosticButton}" Click="SaveDialogTest_Click"/>
                    <Button Content="Browser Test" Style="{StaticResource DiagnosticButton}" Click="BrowserTest_Click"/>
                    <Button Content="Browser Interaction" Style="{StaticResource DiagnosticButton}" Click="BrowserInteractionTest_Click"/>
                    <Button Content="Browser Controls" Style="{StaticResource DiagnosticButton}" Click="BrowserControlsTest_Click"/>
                    <Button Content="0.6E Reliability" Style="{StaticResource DiagnosticButton}" Click="BrowserReliabilityTest_Click"/>
                    <Button Content="0.6F Vision Fallback" Style="{StaticResource DiagnosticButton}" Click="BrowserVisionFallbackTest_Click"/>
                    <Button Content="0.6F Coordinate" Style="{StaticResource DiagnosticButton}" Click="BrowserCoordinateCanvasTest_Click"/>
                    <Button Content="0.6F Final Regression" Style="{StaticResource DiagnosticButton}" Click="BrowserFinalRegressionTest_Click"/>
                    <Button Content="0.7A Native Controls" Style="{StaticResource DiagnosticButton}" Click="NativeControls07ATest_Click"/>
                    <Button Content="0.7A Autonomous" Style="{StaticResource DiagnosticButton}" Click="NativeAgent07ATest_Click"/>
                    <Button Content="0.7B Dialog Workflow" Style="{StaticResource DiagnosticButton}" Click="DialogWorkflow07BTest_Click"/>
                    <Button Content="0.7B Autonomous" Style="{StaticResource DiagnosticButton}" Click="DialogAgent07BTest_Click"/>
                    <Button Content="0.7C Multi-Window" Style="{StaticResource DiagnosticButton}" Click="MultiWindow07CTest_Click"/>
                    <Button Content="0.7C Autonomous" Style="{StaticResource DiagnosticButton}" Click="MultiWindowAgent07CTest_Click"/>
                    <Button Content="0.7C Real Apps" Style="{StaticResource DiagnosticButton}" Click="RealApps07CTest_Click"/>
                    <Button Content="0.7D Write/Save" Style="{StaticResource DiagnosticButton}" Click="RealWrite07DTest_Click"/>
                    <Button Content="0.7D Autonomous" Style="{StaticResource DiagnosticButton}" Click="RealWriteAgent07DTest_Click"/>
                </WrapPanel>
            </ScrollViewer>
        </Expander>

        <Border Grid.Row="4" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="14" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Activity" FontSize="18" FontWeight="SemiBold" Foreground="#111827"/>
                    <TextBlock Grid.Column="1" Text="History: %LOCALAPPDATA%\OperatorAI\history"
                               Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                </Grid>
                <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"
                         Padding="14" Background="#FAFAFA" BorderBrush="#E5E7EB"/>
            </Grid>
        </Border>
    </Grid>
</Window>
