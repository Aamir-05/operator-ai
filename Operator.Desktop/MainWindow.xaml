<Window x:Class="Operator.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operator AI"
        Height="960"
        Width="1420"
        MinHeight="700"
        MinWidth="950"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- HEADER                                            -->
        <!-- ================================================= -->

        <StackPanel Grid.Row="0">

            <TextBlock
                Text="Operator AI"
                FontSize="34"
                FontWeight="Bold"/>

            <TextBlock
                Text="Windows Agent - Version 0.7A"
                FontSize="15"
                Margin="0,5,0,25"/>

        </StackPanel>

        <!-- ================================================= -->
        <!-- TASK                                              -->
        <!-- ================================================= -->

        <TextBlock
            Grid.Row="1"
            Text="What should I do?"
            FontSize="20"
            FontWeight="SemiBold"
            Margin="0,0,0,8"/>

        <TextBox
            x:Name="TaskBox"
            Grid.Row="2"
            Height="105"
            FontSize="16"
            TextWrapping="Wrap"
            AcceptsReturn="True"
            VerticalScrollBarVisibility="Auto"
            Padding="12"
            Margin="0,0,0,15"/>

        <!-- ================================================= -->
        <!-- CONTROLS                                          -->
        <!-- ================================================= -->

        <WrapPanel
            Grid.Row="3"
            Margin="0,0,0,22">

            <Button
                x:Name="AskAIButton"
                Content="Run AI Task"
                Width="145"
                Height="45"
                Margin="0,0,10,10"
                Click="AskAI_Click"/>

            <Button
                x:Name="StopTaskButton"
                Content="Stop Task"
                Width="125"
                Height="45"
                Margin="0,0,10,10"
                IsEnabled="False"
                Click="StopTask_Click"/>

            <Button
                Content="Open Notepad"
                Width="145"
                Height="45"
                Margin="0,0,10,10"
                Click="OpenNotepad_Click"/>

            <Button
                Content="Create Test File"
                Width="145"
                Height="45"
                Margin="0,0,10,10"
                Click="CreateFile_Click"/>

            <Button
                Content="Verify File"
                Width="130"
                Height="45"
                Margin="0,0,10,10"
                Click="VerifyFile_Click"/>

            <Button
                Content="UI Type Test"
                Width="130"
                Height="45"
                Margin="0,0,10,10"
                Click="UiTypeTest_Click"/>

            <Button
                Content="Ctrl+S Test"
                Width="130"
                Height="45"
                Margin="0,0,10,10"
                Click="SaveKeyTest_Click"/>

            <Button
                Content="Save Dialog Test"
                Width="150"
                Height="45"
                Margin="0,0,10,10"
                Click="SaveDialogTest_Click"/>

            <Button
                Content="Browser Test"
                Width="140"
                Height="45"
                Margin="0,0,10,10"
                Click="BrowserTest_Click"/>

            <Button
                Content="Browser Interaction Test"
                Width="190"
                Height="45"
                Margin="0,0,10,10"
                Click="BrowserInteractionTest_Click"/>

            <Button
                Content="Browser Controls Test"
                Width="185"
                Height="45"
                Margin="0,0,10,10"
                Click="BrowserControlsTest_Click"/>

            <Button
                Content="0.6E Reliability Test"
                Width="185"
                Height="45"
                Margin="0,0,10,10"
                Click="BrowserReliabilityTest_Click"/>

            <Button
                Content="0.6F Vision Fallback Test"
                Width="205"
                Height="45"
                Margin="0,0,10,10"
                Click="BrowserVisionFallbackTest_Click"/>

            <Button
                Content="0.6F Coordinate Test"
                Width="190"
                Height="45"
                Margin="0,0,10,10"
                Click="BrowserCoordinateCanvasTest_Click"/>

            <Button
                Content="0.6F FINAL REGRESSION"
                Width="220"
                Height="45"
                Margin="0,0,10,10"
                FontWeight="Bold"
                Click="BrowserFinalRegressionTest_Click"/>

            <Button
                Content="0.7A Native Controls Test"
                Width="220"
                Height="45"
                Margin="0,0,10,10"
                FontWeight="Bold"
                Click="NativeControls07ATest_Click"/>

        </WrapPanel>

        <!-- ================================================= -->
        <!-- ACTIVITY                                          -->
        <!-- ================================================= -->

        <TextBlock
            Grid.Row="4"
            Text="Activity"
            FontSize="20"
            FontWeight="SemiBold"
            Margin="0,0,0,10"/>

        <TextBox
            x:Name="LogBox"
            Grid.Row="5"
            IsReadOnly="True"
            TextWrapping="Wrap"
            AcceptsReturn="True"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Auto"
            FontFamily="Consolas"
            FontSize="14"
            Padding="15"/>

    </Grid>

</Window>