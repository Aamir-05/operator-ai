<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Operator.AI\Operator.AI.csproj" />
    <ProjectReference Include="..\Operator.Tools\Operator.Tools.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <Version>0.8.0</Version>
    <AssemblyVersion>0.8.0.0</AssemblyVersion>
    <FileVersion>0.8.0.0</FileVersion>
    <Product>Operator AI</Product>
    <Company>Operator AI</Company>
    <Description>Unified Windows and browser automation agent.</Description>
    <Deterministic>true</Deterministic>

    <!-- Playwright browser assets are easier to manage with normal publish output. -->
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

</Project>
