<Window x:Class="Operator.Desktop.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair Operator AI Mobile"
        Width="720"
        Height="820"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F5F7"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,18">

            <TextBlock Text="Pair Mobile Device"
                       FontSize="28"
                       FontWeight="Bold"/>

            <TextBlock Text="Scan this QR code from Operator AI Mobile."
                       Foreground="#64748B"
                       FontSize="15"
                       Margin="0,6,0,0"/>

        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="14"
                Padding="28">

            <StackPanel HorizontalAlignment="Center">

                <Border Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="20"
                        Margin="0,0,0,18">

                    <Image x:Name="QrImage"
                           Width="440"
                           Height="440"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                </Border>

                <TextBlock Text="Pairing code"
                           HorizontalAlignment="Center"
                           Foreground="#64748B"
                           FontSize="14"/>

                <TextBlock x:Name="PairCodeText"
                           Text="------"
                           FontFamily="Consolas"
                           FontSize="38"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,14"/>

                <TextBlock x:Name="PairingStatusText"
                           Text="Starting pairing session..."
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="#334155"
                           FontSize="14"
                           MaxWidth="560"/>

                <TextBlock x:Name="PairUriText"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           FontSize="10"
                           Foreground="#CBD5E1"
                           MaxWidth="560"
                           Margin="0,12,0,0"/>

            </StackPanel>

        </Border>

        <Button Grid.Row="2"
                Content="Close"
                Width="120"
                Height="42"
                HorizontalAlignment="Right"
                Margin="0,18,0,0"
                IsCancel="True"/>

    </Grid>

</Window>